# All optional. With no API, Natour can't check places; with no AI provider, plans are built by hand.
# The shared backend (ew-apps-api): place search (Nominatim/Overpass), photos and "Natour AI (free)".
VITE_API_URL=http://localhost:8787
# Supabase project used for sign-in to the AI server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to 1 once the Google provider is enabled in Supabase, to show "Continue with Google".
VITE_GOOGLE_SIGNIN=
